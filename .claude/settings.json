{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/protect_raw.py\"",
            "timeout": 10,
            "statusMessage": "Checking raw/ immutability"
          }
        ]
      }
    ]
  }
}
